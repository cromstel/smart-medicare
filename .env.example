# Smart MediCare - Environment Configuration Template
# Copy this file to .env.local and fill in the values.
# All secrets must be provided via environment variables in production.

########################################
# Application
########################################
# The product name is configuration, never code.
# The browser reads VITE_APP_NAME, the API reads APP_NAME.
# In production both are required. In development they fall back to this value.
VITE_APP_NAME="Smart MediCare"
APP_NAME="Smart MediCare"

########################################
# Server (API) Network
########################################
# The ports the API listens on. A missing port is reported by name rather than guessed.
PORT=5000
HTTPS_PORT=8443

########################################
# Frontend (Vite) Network
########################################
# The port the Vite dev/preview server binds to.
VITE_PORT=5175
# The host the dev/preview server binds to.
VITE_HOST=0.0.0.0
# The hosts the dev/preview server answers to.
VITE_ALLOWED_HOSTS=
# The preview server used by the end-to-end suite.
VITE_PREVIEW_PORT=3001
# Where the end-to-end suite finds the API. Unset means the origin of
# VITE_API_URL, and then the API's own port.
E2E_API_ORIGIN=
# The certificate and key for the HTTPS listener. Unset means
# server/certs/cert.pem and server/certs/key.pem.
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=

########################################
# Where the built front-end is served from. Unset means it is looked for in
# public/ and then in dist/ beside the application.
FRONTEND_DIST_DIR=

########################################
# Browser client
########################################
# Where the application is published. The browser shows it, and it is the
# address written into a calendar invitation.
VITE_BASE_URL=http://localhost:5175
# Where the browser calls the API. Unset means the same origin, at /api.
VITE_API_URL=http://localhost:5000/api
# Set to true to always use the same-origin /api path in development, for
# example when the development server proxies /api to the API server.
VITE_DEV_API_PROXY_ONLY=false
# Set to false to switch the product analytics off.
VITE_ANALYTICS_ENABLED=true
# The ICE servers used for real-time connections, comma separated. Unset means
# none, which is enough for a connection whose two ends are on one machine.
VITE_ICE_SERVERS=

########################################
# Database
########################################
# The application database. The password has no default.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_medicare
DB_USER=root
DB_PASSWORD=
DB_SSL=false
DB_SSL_CA=

########################################
# Authentication & Security
########################################
# The JWT secret. Required in production.
JWT_SECRET=REPLACE_WITH_JWT_SECRET
JWT_EXPIRES_IN=24h
# The session secret. Required in production.
SESSION_SECRET=REPLACE_WITH_SESSION_SECRET
# 32-byte key and 16-byte IV, hex encoded. Required in production.
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_KEY
ENCRYPTION_IV=REPLACE_WITH_32_HEX_CHAR_KEY
# The bcrypt cost for new passwords.
BCRYPT_ROUNDS=10
# How many times a password may be deferred before it must be changed.
PASSWORD_MAX_POSTPONES=3
# Maximum login attempts before lockout.
MAX_LOGIN_ATTEMPTS=5
# Lockout duration in milliseconds.
LOCKOUT_DURATION=900000
# Login rate limit.
LOGIN_RATE_LIMIT_MAX=5
# Password reset rate limit.
PASSWORD_RESET_RATE_LIMIT_MAX=10
# Password reset TTL in minutes.
PASSWORD_RESET_TTL_MINUTES=30
# Session cookie settings.
SESSION_COOKIE_NAME=shms_session
SESSION_COOKIE_MAX_AGE=28800000
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_RESAVE=false
SESSION_SAVE_UNINITIALIZED=true
# WebAuthn
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:5175
WEBAUTHN_RP_NAME="Smart MediCare"

########################################
# Email (SMTP) - Gmail is default provider
########################################
# Email provider: gmail, outlook, yahoo, sendgrid, mailgun, postmark, amazon_ses, mailjet, sparkpost, or custom
# Default: gmail
EMAIL_PROVIDER=gmail

# Explicit SMTP configuration (overrides EMAIL_PROVIDER if set)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_REPLY_TO=
# SMTP_SECURE=false

# Email provider selection (used when SMTP_HOST is not set)
# Available built-in providers: gmail, outlook, outlook_com, yahoo, sendgrid, mailgun, postmark, amazon_ses, mailjet, sparkpost
EMAIL_PROVIDER=gmail

# Gmail configuration (default provider)
# For Gmail, use App Password: https://support.google.com/accounts/answer/185833
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Custom provider configuration (JSON format)
# Example: {"custom": {"host": "smtp.custom.com", "port": 587, "secure": false}}
# EMAIL_PROVIDERS={"custom": {"host": "smtp.custom.com", "port": 587, "secure": false}}

# Email sender configuration
MAIL_FROM_NAME="Smart MediCare"
EMAIL_FROM=no-reply@example.com
EMAIL_REPLY_TO=

# Legacy SMTP configuration (deprecated, use EMAIL_PROVIDER instead)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_REPLY_TO=
# SMTP_SECURE=false

MAIL_FROM_NAME="Smart MediCare"
EMAIL_FROM=no-reply@example.com
EMAIL_REPLY_TO=
DEMO_REQUEST_RECIPIENT=
ADMIN_EMAIL=admin@smarthealth.com

########################################
# File Upload
########################################
UPLOAD_DIR=server/uploads
MAX_FILE_SIZE=10485760
LOCAL_STORAGE_QUOTA_BYTES=5242880

########################################
# Backup
########################################
BACKUP_DIR=server/backups
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=30
MYSQLDUMP_BIN=mysqldump

########################################
# Retention
########################################
RETENTION_CRON=30 3 * * *
AUDIT_LOG_RETENTION_DAYS=2555
ANALYTICS_EVENT_RETENTION_DAYS=365
NOTIFICATION_DEDUPE_RETENTION_DAYS=30
SHARED_SUMMARY_RETENTION_DAYS=90

########################################
# Ghana Health Service Integration
########################################
GHS_DB_HOST=
GHS_DB_PORT=3306
GHS_DB_NAME=
GHS_DB_USER=
GHS_DB_PASSWORD=
GHS_DB_SSL=false
GHS_DB_SSL_CA=

########################################
# Seeded Demo Accounts
########################################
# The local seed creates the demo accounts with these passwords, hashing them
# at seed time. No password and no hash is stored in the repository.
SUPER_ADMIN_PASSWORD=REPLACE_WITH_SUPER_ADMIN_PASSWORD
ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
DOCTOR_PASSWORD=REPLACE_WITH_DOCTOR_PASSWORD
PATIENT_PASSWORD=REPLACE_WITH_PATIENT_PASSWORD
NURSE_PASSWORD=REPLACE_WITH_NURSE_PASSWORD
PHARMACIST_PASSWORD=REPLACE_WITH_PHARMACIST_PASSWORD
LAB_TECHNICIAN_PASSWORD=REPLACE_WITH_LAB_TECHNICIAN_PASSWORD
HOSPITAL_MANAGEMENT_PASSWORD=REPLACE_WITH_HOSPITAL_MANAGEMENT_PASSWORD
RECEPTIONIST_PASSWORD=REPLACE_WITH_RECEPTIONIST_PASSWORD
BILLING_SPECIALIST_PASSWORD=REPLACE_WITH_BILLING_SPECIALIST_PASSWORD
INSURANCE_COORDINATOR_PASSWORD=REPLACE_WITH_INSURANCE_COORDINATOR_PASSWORD
MEDICAL_RECORDS_CLERK_PASSWORD=REPLACE_WITH_MEDICAL_RECORDS_CLERK_PASSWORD
RADIOLOGY_TECHNICIAN_PASSWORD=REPLACE_WITH_RADIOLOGY_TECHNICIAN_PASSWORD
# The bcrypt cost the seed uses.
BCRYPT_ROUNDS=10
# The platform accounts. SUPER_ADMIN_PASSWORD and ADMIN_PASSWORD are the
# accepted aliases of the two variables above.
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_SUPER_ADMIN_PASSWORD
ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD

########################################
# Rate Limiting
########################################
RATE_LIMIT_MAX_REQUESTS=2000
RATE_LIMIT_WINDOW_MS=900000

########################################
# AI / Gemini
########################################
GEMINI_API_KEY=
GEMINI_SEND_PHI=false
GEMINI_TIMEOUT_MS=120000
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
GEMINI_MODEL_FLASH=gemini-3.8-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_RATE_LIMIT_MAX=20

########################################
# AI / SAM support assistant
#
# SAM answers platform questions. It has no access to any account,
# patient record, or clinical data -- it is given the platform's own
# documentation and nothing else. The provider and the model are also
# chosen from the Super Admin settings screen, which overrides the
# values here.
#
# The key belongs to the provider that is used. Leave every key empty
# and SAM answers with a clearly labelled placeholder instead of
# contacting anyone.
########################################
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# The provider used when the Super Admin screen has not chosen one.
SAM_PROVIDER=openrouter
# The model used when the Super Admin screen has not chosen one.
SAM_MODEL=meta-llama/llama-3.1-8b-instruct:free
# How long a single answer may take before the request is abandoned.
SAM_TIMEOUT_MS=60000
# How many questions one address may ask in a quarter of an hour.
SAM_RATE_LIMIT_MAX=20

########################################
# Payment / Stripe
########################################
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd

########################################
# Twilio
########################################
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

########################################
# Google Drive
########################################
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5000/api/storage/google/callback

########################################
# OneDrive
########################################
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URI=http://localhost:5000/api/storage/onedrive/callback

########################################
# Shared Summary
########################################
SHARED_SUMMARY_TTL_HOURS=24

########################################
# Rate Limiting
########################################
SHARED_SUMMARY_TTL_HOURS=24

########################################
# AI Features
########################################
GEMINI_SEND_PHI=false
GEMINI_TIMEOUT_MS=120000
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
GEMINI_MODEL_FLASH=gemini-3.8-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_RATE_LIMIT_MAX=20

########################################
# Redis (optional)
########################################
REDIS_URL=

########################################
# S3 / MinIO
########################################
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

########################################
# Feature Flags
########################################
FEATURE_AI_ASSISTANT=true
FEATURE_TELEMEDICINE=true
FEATURE_PATIENT_PORTAL=true
FEATURE_EMERGENCY_BOARD=true
FEATURE_PHARMACY=true
FEATURE_INVENTORY=true
FEATURE_FINANCIAL=true
FEATURE_AUDIT_LOGS=true
FEATURE_BACKUP=true